#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
        };

        combo_lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 16>;
        };

        combo_lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
        };

        combo_rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        combo_rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };

        combo_rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
        };

        combo_langle {
            bindings = <&kp LESS_THAN>;
            key-positions = <13 14>;
        };

        combo_rangle {
            bindings = <&kp GREATER_THAN>;
            key-positions = <21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q        &kp W       &kp F        &kp P       &kp B          &kp J        &kp L            &kp U                &kp Y            &kp SEMICOLON  &kp MINUS
&kp GRAVE  &mt LSHFT A  &mt LALT R  &mt LCTRL S  &mt LGUI T  &kp G          &kp M        &mt RGUI N       &mt RIGHT_CONTROL E  &mt RIGHT_ALT I  &mt RSHFT O    &kp APOSTROPHE
&trans     &kp Z        &kp X       &kp C        &kp D       &kp V          &kp K        &kp H            &kp COMMA            &kp DOT          &kp FSLH       &kp BACKSLASH
                                    &mo 2        &lt 2 TAB   &lt 1 SPACE    &lt 1 ENTER  &lt 2 BACKSPACE  &mo 2
            >;
        };

        sym_num_layer {
            display-name = "Sym Num";
            bindings = <
&trans  &trans  &kp AMPERSAND    &kp ASTERISK  &kp GRAVE  &trans    &kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH     &trans
&trans  &trans  &kp DOLLAR       &kp PERCENT   &kp CARET  &trans    &kp PLUS      &kt NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &trans
&trans  &trans  &kp EXCLAMATION  &kp AT        &kp HASH   &trans    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &trans
                                 &trans        &trans     &trans    &trans        &trans        &trans
            >;
        };

        brd_sym_layer {
            display-name = "Brd Func";
            bindings = <
&trans      &trans  &kp F7  &kp F8  &kp F9  &kp F12    &kp PAGE_UP    &kp HOME              &kp UP_ARROW          &kp END    &kp C_VOLUME_UP    &trans
&bt BT_NXT  &trans  &kp F4  &kp F5  &kp F6  &kp F11    &kp PAGE_DOWN  &kp LEFT_ARROW        &kp DOWN              &kp RIGHT  &kp C_VOLUME_DOWN  &trans
&bt BT_PRV  &trans  &kp F1  &kp F2  &kp F3  &kp F10    &trans         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans     &trans             &bt BT_CLR
                            &trans  &trans  &trans     &trans         &trans                &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };

    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;          // Slightly bumped to give intentional holds time
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;    // Prevents mods during active typing rolls
            bindings = <&kp>, <&kp>;
        };
    };
};
